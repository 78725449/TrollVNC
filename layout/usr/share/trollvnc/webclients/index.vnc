<!-- index.vnc - TrollVNC 自动连接响应式页面（内网自用版）
     $PORT 由 LibVNCServer 替换为 VNC 端口
     操作集由能力清单驱动（caps.js，与网关控制台同源；宪法 6.6） -->
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>TrollVNC</title>
<style>
  html, body { margin: 0; height: 100%; background: #000; overflow: hidden; }
  body { display: flex; align-items: center; justify-content: center; }
  #stage { display: flex; align-items: stretch; max-width: 100vw; max-height: 100vh; }
  #screen { position: relative; background: #000; }
  #screen canvas { position: absolute; left: 0; top: 0; }
  #hint {
    position: absolute; left: 8px; top: 8px; z-index: 5;
    color: #bbb; background: rgba(0,0,0,.6); padding: 4px 10px;
    border-radius: 12px; font: 12px system-ui, sans-serif; pointer-events: none;
    max-width: 80%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  /* 桌面：右侧紧贴屏幕的操作面板（图标 + hover 提示） */
  #bar {
    width: 60px; flex: 0 0 60px;
    display: flex; flex-direction: column; gap: 6px;
    background: #141414; padding: 8px 6px; box-sizing: border-box;
    overflow-y: auto;
  }
  #barCaps { display: flex; flex-direction: column; gap: 6px; }
  #bar button {
    min-height: 44px; font-size: 18px; border: 1px solid #333;
    background: #222; color: #eee; border-radius: 10px; cursor: pointer;
  }
  #bar button:active { background: #3a3a3a; }

  /* 移动端：全屏画面 + 悬浮菜单按钮 */
  #fabBtn {
    display: none; position: fixed; right: 16px; bottom: 24px; z-index: 60;
    width: 56px; height: 56px; border-radius: 50%; font-size: 24px;
    background: #4f8cff; color: #fff; border: none; cursor: pointer;
    box-shadow: 0 6px 20px rgba(0,0,0,.5);
  }
  #opsMenu {
    display: none; position: fixed; right: 12px; bottom: 96px; z-index: 65;
    width: min(300px, 90vw); background: #1f2a40; border: 1px solid #2b3852;
    border-radius: 14px; padding: 10px; box-shadow: 0 8px 28px rgba(0,0,0,.55);
  }
  #opsMenu.show { display: block; }
  #opsMenu .g { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  #opsMenu .g button { min-height: 44px; font-size: 18px; border: 1px solid #2b3852; background: #222; color: #eee; border-radius: 10px; }
  #opsMenu #menuClose { width: 100%; margin-top: 8px; padding: 8px; border-radius: 10px; border: 1px solid #2b3852; background: #333; color: #ff9d9d; }

  @media (max-width: 900px) {
    #bar { display: none; }
    #fabBtn { display: block; }
    #stage { max-width: 100vw; }
  }
</style>
</head>
<body>
<div id="stage">
  <div id="screen"><div id="hint">连接中…</div></div>
  <div id="bar">
    <div id="barCaps"></div>
    <hr style="border:none;border-top:1px solid #333;margin:4px 0" />
    <button data-op="fit" title="适配画面">⛶</button>
    <button data-op="full" title="全屏">🖥️</button>
    <button data-op="disc" title="断开" style="color:#ff9d9d">⏹</button>
  </div>
</div>
<button id="fabBtn" title="设备操作">⚙</button>
<div id="opsMenu">
  <div class="g" id="opsCaps"></div>
  <div class="g" style="margin-top:6px">
    <button data-op="fit" title="适配">⛶</button>
    <button data-op="full" title="全屏">🖥️</button>
    <button data-op="disc" title="断开">⏹</button>
  </div>
  <button id="menuClose">✕ 关闭</button>
</div>
<script type="module">
import RFB from './novnc/core/rfb.js';
import { DEFAULT_CAPS, CAP_META } from './caps.js';
(function () {
  var host = location.hostname;
  var port = $PORT;
  var wsProto = location.protocol === 'https:' ? 'wss://' : 'ws://';
  var url = wsProto + host + ':' + port + '/websockify';

  var screen = document.getElementById('screen');
  var hint = document.getElementById('hint');
  var rfb = new RFB(screen, url, {});
  rfb.scaleViewport = true;
  rfb.resizeSession = false;
  rfb.showDotCursor = true;

  rfb.addEventListener('connect', function () { hint.textContent = '已连接 ' + host + ':' + port; });
  rfb.addEventListener('disconnect', function () { hint.textContent = '已断开'; });
  rfb.addEventListener('credentialsrequired', function () {
    var p = window.prompt('请输入 VNC 密码：');
    if (p) rfb.sendCredentials({ password: p });
  });

  function tapKey(ks, code) {
    try { rfb.sendKey(ks, code, true); } catch (e) { return; }
    setTimeout(function () { try { rfb.sendKey(ks, code, false); } catch (e) {} }, 60);
  }
  function pointer(mask) {
    try {
      var b = new Uint8Array(6);
      b[0] = 5; b[1] = mask; b[2] = 0; b[3] = 1; b[4] = 0; b[5] = 1;
      rfb._sock.send(b.buffer);
      if (mask !== 0) setTimeout(function () { pointer(0); }, 80);
    } catch (e) {}
  }
  function doOp(op) {
    switch (op) {
      case 'home': tapKey(0xff50, 'Home'); break;
      case 'power': pointer(2); break;
      case 'volup': tapKey(0x1008ff13, 'AudioVolumeUp'); break;
      case 'voldn': tapKey(0x1008ff11, 'AudioVolumeDown'); break;
      case 'mute': tapKey(0x1008ff12, 'AudioVolumeMute'); break;
      case 'briup': tapKey(0x1008ff03, 'BrightnessUp'); break;
      case 'bridn': tapKey(0x1008ff02, 'BrightnessDown'); break;
      case 'kb': try { rfb.focus(); } catch (e) {} break;
      case 'clip':
        navigator.clipboard.readText().then(function (t) { if (t) try { rfb.clipboardPasteFrom(t); } catch (e) {} }).catch(function () {});
        break;
      case 'fit': rfb.scaleViewport = true; break;
      case 'full':
        if (document.fullscreenElement) document.exitFullscreen();
        else document.documentElement.requestFullscreen().catch(function () {});
        break;
      case 'disc': try { rfb.disconnect(); } catch (e) {} break;
    }
  }
  // 能力清单驱动渲染（宪法 5.2/6.6）：设备操作来自清单（优先 runtime 注入 window.TVNC_CAPS），
  // 适配/全屏/断开为本地操作，由静态按钮提供
  function renderCapOps(container) {
    if (!container) return;
    var caps = (window.TVNC_CAPS && window.TVNC_CAPS.length) ? window.TVNC_CAPS : DEFAULT_CAPS;
    container.innerHTML = '';
    caps.forEach(function (c) {
      var meta = CAP_META[c];
      if (!meta) return;
      var b = document.createElement('button');
      b.type = 'button';
      b.dataset.op = meta.op;
      b.title = meta.title;
      b.textContent = meta.icon;
      b.addEventListener('click', function () { doOp(meta.op); });
      container.appendChild(b);
    });
  }
  renderCapOps(document.getElementById('barCaps'));
  renderCapOps(document.getElementById('opsCaps'));
  function bind(sel) {
    document.querySelectorAll(sel).forEach(function (b) {
      b.addEventListener('click', function () { doOp(b.dataset.op); });
    });
  }
  bind('#bar [data-op]');
  bind('#opsMenu [data-op]');
  document.getElementById('fabBtn').addEventListener('click', function () {
    document.getElementById('opsMenu').classList.toggle('show');
  });
  document.getElementById('menuClose').addEventListener('click', function () {
    document.getElementById('opsMenu').classList.remove('show');
  });
})();
</script>
</body>
</html>
