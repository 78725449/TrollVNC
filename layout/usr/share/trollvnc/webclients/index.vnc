<!-- index.vnc - TrollVNC 自动连接响应式页面（悬浮按钮版，2026-08）
     $PORT 由 LibVNCServer 替换为 VNC 端口
     连接代码与原始可用版逐字节一致：仅依赖 noVNC core/rfb.js（无额外模块依赖）
     交互方案：
       手机端（触屏/窄屏）：画面全屏 + 一个可拖动悬浮按钮(FAB)，点击展开操作列
       PC 端（鼠标/宽屏）：画面居中，右侧操作栏贴画面右边框（JS 动态定位，见 syncBarPosition）
     操作集：内联默认值；caps.js 仅在可加载时作为增强（失败不影响连接）
     状态提示：画布中央浮层（连接中加载动画 / 已连接等待 / 已断开 / 连接失败），收到首帧后隐藏 -->
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<link rel="icon" href="data:," />
<title>SuperPhone</title>
<style>
  /* 安全区域变量：JS 通过 getComputedStyle 读取，用于 FAB 拖动边界约束 */
  :root {
    --safe-top: env(safe-area-inset-top);
    --safe-right: env(safe-area-inset-right);
    --safe-bottom: env(safe-area-inset-bottom);
    --safe-left: env(safe-area-inset-left);
  }
  html, body { margin: 0; height: 100%; background: #000; overflow: hidden; }
  body { display: flex; flex-direction: column; }
  #screen { flex: 1; position: relative; min-height: 0; background: #000; }
  /* 不设置 #screen canvas 定位规则：交给 noVNC 内部 flex + margin:auto 自动居中（黑边留白） */
  /* 中央状态浮层：连接中加载动画 / 已连接等待 / 已断开 / 连接失败（原左上角提示移至画布中心） */
  #status {
    position: absolute; inset: 0; z-index: 5;
    display: none;
    flex-direction: column; align-items: center; justify-content: center; gap: 14px;
    background: rgba(0, 0, 0, .5);
    pointer-events: none; user-select: none; -webkit-user-select: none;
  }
  #status.show { display: flex; }
  #status .spin {
    display: none;
    width: 38px; height: 38px; border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, .18); border-top-color: #7C5CFF;
    animation: spin .8s linear infinite;
  }
  #status.loading .spin { display: block; }
  @keyframes spin { to { transform: rotate(360deg); } }
  #statusText {
    color: #eee; font: 14px/1.5 system-ui, sans-serif;
    text-align: center; max-width: 86%;
    word-break: break-all; text-shadow: 0 1px 3px rgba(0, 0, 0, .8);
  }

  /* ===== PC 端操作栏（鼠标 + 宽屏显示）：fixed 脱离 flex 流，运行时定位到画面右边框 ===== */
  #bar {
    display: none;
    position: fixed; z-index: 6;
    gap: clamp(4px, 1.5vw, 10px); justify-content: flex-start;
    padding: 8px; background: #141414; flex-direction: column;
    overflow-y: auto; -webkit-overflow-scrolling: touch;
  }
  #bar button {
    flex: 0 0 auto;
    min-width: 64px; min-height: 44px;
    border: 1px solid #333; background: #222; color: #eee;
    border-radius: 10px; font: 500 13px system-ui, sans-serif;
    padding: 4px 10px;
    display: flex; align-items: center; justify-content: flex-start;
    gap: 8px;
  }
  #bar button:active { background: #3a3a3a; }
  @media (min-width: 900px) and (hover: hover) and (pointer: fine) {
    body { flex-direction: row; }
    #bar { display: flex; }
  }

  /* ===== 手机端悬浮信号按钮 FAB（触屏/窄屏显示，WiFi 白底样式） ===== */
  #fab {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    top: 25%;                        /* 默认：靠右边，垂直在屏幕高度 1/4 处 */
    width: 56px; height: 56px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, .12);
    box-shadow: 0 6px 24px rgba(0, 0, 0, .45);
    z-index: 10;
    touch-action: none;              /* 拖动时阻止浏览器默认滚动 */
    user-select: none; -webkit-user-select: none;
    cursor: grab;
    display: flex; align-items: center; justify-content: center;
  }
  #fab:active { cursor: grabbing; }
  #fab.dragging { cursor: grabbing; }
  /* WiFi 信号图标：三段弧（a1 外 / a2 中 / a3 内+点），按连接状态亮起 */
  #fab .wifi { width: 30px; height: 30px; display: block; }
  #fab .wifi .arc { fill: #cbd5e1; transition: fill .2s; }   /* 未亮：浅灰 */
  #fab[data-sig="sig-high"] .wifi .arc { fill: #22c55e; }    /* 已连接：全绿 */
  #fab[data-sig="sig-mid"] .wifi .arc.a2,
  #fab[data-sig="sig-mid"] .wifi .arc.a3 { fill: #eab308; }  /* 中格：中弧+点 黄 */
  #fab[data-sig="sig-low"] .wifi .arc.a3 { fill: #ef4444; }  /* 低格：点 红 */
  @media (min-width: 900px) and (hover: hover) and (pointer: fine) {
    #fab { display: none; }
  }

  /* ===== 操作面板（点击 FAB 展开）——白色卡片风格（与网关 opsMenu 对齐） ===== */
  #panel {
    position: fixed;
    display: none;
    flex-direction: column;
    gap: 6px;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, .12);
    padding: 8px;
    border-radius: 14px;
    z-index: 11;
    max-height: 70vh;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    min-width: 152px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, .28);
  }
  #panel.show { display: flex; }
  #panel button {
    min-height: 44px; min-width: 140px;
    border: 1px solid rgba(0, 0, 0, .08); background: #f5f6f8; color: #1c1c1e;
    border-radius: 10px; font: 500 14px system-ui, sans-serif;
    padding: 8px 12px;
    display: flex; align-items: center; justify-content: flex-start;
    gap: 8px;
  }
  #panel button:active { background: #e9eaee; }
  /* 面板/PC 栏 SF Symbols 图标尺寸（stroke=currentColor 跟随文字颜色） */
  #panel button svg, #bar button svg { width: 20px; height: 20px; flex: 0 0 auto; }
  /* 「键盘」键激活高亮（2026-08-14 对齐原生 noVNC「Show Keyboard」：软键盘显示时点亮） */
  #panel button.kbd-on, #bar button.kbd-on {
    background: #2196f3; color: #fff; border-color: #2196f3;
  }
  @media (min-width: 900px) and (hover: hover) and (pointer: fine) {
    #panel { display: none !important; }
  }

  /* 横屏手机：FAB 稍小，避免遮挡 */
  @media (max-width: 900px) and (orientation: landscape) and (max-height: 500px) {
    #fab { width: 48px; height: 48px; }
    #fab .wifi { width: 26px; height: 26px; }
  }

  /* ===== 剪贴板手动输入浮层（HTTP 环境降级方案） ===== */
  #clipOverlay {
    position: fixed; inset: 0; z-index: 20;
    background: rgba(0, 0, 0, .6);
    display: none;
    align-items: center; justify-content: center;
    padding: max(16px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right)) max(16px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));
  }
  #clipOverlay.show { display: flex; }
  #clipModal {
    background: #1c1c1e; border: 1px solid #3a3a3c;
    border-radius: 14px; padding: 16px;
    width: 100%; max-width: 360px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, .5);
  }
  #clipModal h3 {
    margin: 0 0 4px; font: 600 16px/24px system-ui, sans-serif; color: #eee;
  }
  #clipModal p {
    margin: 0 0 12px; font: 12px/18px system-ui, sans-serif; color: #999;
  }
  #clipText {
    width: 100%; min-height: 96px;
    background: #2c2c2e; border: 1px solid #3a3a3c;
    border-radius: 10px; color: #eee;
    font: 14px/20px system-ui, sans-serif;
    padding: 10px; resize: vertical;
    box-sizing: border-box; -webkit-appearance: none;
  }
  #clipText:focus { outline: 2px solid var(--brand, #7C5CFF); }
  .clip-btns { display: flex; gap: 8px; margin-top: 12px; }
  .clip-btns button {
    flex: 1; min-height: 44px;
    border-radius: 10px; border: 1px solid #3a3a3c;
    font: 500 15px system-ui, sans-serif; padding: 8px;
  }
  #clipCancel { background: #2c2c2e; color: #eee; }
  #clipSend { background: #7C5CFF; color: #fff; border-color: #7C5CFF; }
  #clipSend:active { background: #5B3FE0; }
</style>
</head>
<body>
<div id="screen">
  <!-- 中央状态浮层：加载动画在画布中心，收到首帧后隐藏进入画面，断开/失败时居中提示 -->
  <div id="status" class="status loading show">
    <div class="spin"></div>
    <div id="statusText">连接中…</div>
  </div>
</div>

<!-- PC 端侧边栏（按钮由 renderKeys 按 BAR_KEYS 常量渲染） -->
  <div id="bar"></div>

  <!-- 软键盘输入源：kb 键聚焦此隐藏 input 唤起 iOS 软键盘（canvas 非输入元素 focus 无效），
       Keyboard 实例绑定它抓取 keydown/keyup 直发设备（noVNC 官方 touch 键盘方案） -->
  <input id="kbInput" type="text" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
         aria-hidden="true" tabindex="-1"
         style="position:absolute;left:-9999px;top:0;width:1px;height:1px;opacity:0;border:0;pointer-events:none;" />

<!-- 手机端悬浮信号按钮（WiFi 白底，拖动调整位置，点击展开操作） -->
<button id="fab" aria-label="设备信号（拖动调整位置，点击展开操作）">
  <svg class="wifi" viewBox="0 0 24 24" aria-hidden="true">
    <path class="arc a1" d="M1 9l2 2c4.97-4.97 13.03-4.97 18 0l2-2C16.93 2.93 7.08 2.93 1 9z" fill="currentColor"/>
    <path class="arc a2" d="M5 13l2 2c2.76-2.76 7.24-2.76 10 0l2-2C15.14 9.14 8.87 9.14 5 13z" fill="currentColor"/>
    <path class="arc a3" d="M9 17l3 3 3-3c-1.65-1.66-4.34-1.66-6 0z" fill="currentColor"/>
  </svg>
</button>
<div id="panel" role="menu">
  <!-- 按钮由 renderKeys 按 BAR_KEYS 常量渲染（末尾追加「收起菜单」close 按钮） -->
</div>

<!-- 剪贴板手动输入浮层（HTTP 环境降级：Clipboard API 被拒绝时使用） -->
<div id="clipOverlay">
  <div id="clipModal">
    <h3>📋 粘贴到手机</h3>
    <p>浏览器拒绝自动读取剪贴板，请长按下方输入框手动粘贴内容后发送。</p>
    <textarea id="clipText" placeholder="在此粘贴要发送到手机的文字…" autocomplete="off"></textarea>
    <div class="clip-btns">
      <button id="clipCancel">取消</button>
      <button id="clipSend">发送</button>
    </div>
  </div>
</div>

<script type="module">
import RFB from './novnc/core/rfb.js';
import Keyboard from './novnc/core/input/keyboard.js';   // 软键盘 keydown/keyup 抓取（noVNC 官方 touch 键盘方案）

(function () {
  var host = location.hostname;
  var port = $PORT;
  var wsProto = location.protocol === 'https:' ? 'wss://' : 'ws://';
  var url = wsProto + host + ':' + port + '/websockify';
  // 键盘按钮（2026-08-14 对齐上游原生 noVNC「Show Keyboard」语义）
  // 「键盘」键 = 显示/隐藏控制端软键盘（noVNC 原生 toggleVirtualKeyboard：聚焦/失焦隐藏 input）。
  // 控制端软键盘按键经 Keyboard 实例捕获 → rfb.sendKey(keysym) → 设备端 kbdEvent 注入 HID（远程打字）。
  // 被控端键盘完全由被控端系统管理（点被控画面输入框才弹），不注入 attach/detach、无输入源切换。
  // 演进回滚：删除输入源切换两态（kbdControl）+ HID attach 自定义 keysym（XF86KeyboardHide/Show）逻辑。
  var kbdSoft = false;        // 控制端软键盘当前是否显示（kbInput 是否聚焦，focus/blur 事件驱动）
  var kbdBtns = [];           // 键盘键按钮引用（PC 栏 + 面板，软键盘激活时加 .kbd-on 高亮）
  // 触屏能力检测：仅用于"自动弹控制端软键盘"（PC 无系统软键盘）；按钮开关行为本身无判定
  var isTouch = 'ontouchstart' in window || (navigator.maxTouchPoints || 0) > 0;

  var screen = document.getElementById('screen');
  var status = document.getElementById('status');
  var statusText = document.getElementById('statusText');
  var isConnected = false;   // RFB 是否已建立连接（驱动信号按钮延迟轮询）
  var sigTimer = null;       // 延迟轮询定时器（每 3s 同源 fetch 测 RTT）
  var rfb = new RFB(screen, url, {});
  rfb.scaleViewport = true;
  rfb.resizeSession = false;
  // 光标策略（2026-08-14 与网关前端 app.js 对齐）：
  // - 手机触控版（isTouch）：无常驻光标——showDotCursor=false，服务端光标开启时触屏点击/移动显示
  //   服务端圆点、空闲 1.5s 自动隐藏；服务端光标关闭时无光标
  // - PC 版：保持 noVNC 默认 showDotCursor=true（服务端光标优先，dot 白点黑边兜底）
  if (isTouch) {
    rfb.showDotCursor = false;
    var cursorTimer = null;
    var CURSOR_IDLE_MS = 1500;
    var cursorHide = function () {
      if (rfb._cursor && rfb._cursor._canvas) rfb._cursor._hideCursor();
    };
    // 苹果风格触控光标（2026-08-14）：iOS 系统触摸指示器样式——半透明灰圆，
    // 触屏点击/移动时显示、空闲 1.5s 自动隐藏。不显示服务端光标图像（白点黑边不合苹果风格）。
    var APPLE_CURSOR_SIZE = 24, APPLE_CURSOR_R = 9;
    var appleCursorRgba = (function () {
      var S = APPLE_CURSOR_SIZE, cx = (S - 1) / 2, cy = (S - 1) / 2, R = APPLE_CURSOR_R;
      var rgba = new Uint8Array(S * S * 4);
      for (var y = 0; y < S; y++) {
        for (var x = 0; x < S; x++) {
          var d = Math.hypot(x - cx, y - cy);
          var i = (y * S + x) * 4;
          if (d <= R) {
            rgba[i] = 128; rgba[i + 1] = 128; rgba[i + 2] = 128; // 深灰（2026-08-14 加深）
            rgba[i + 3] = Math.round(217 * (1.0 - 0.6 * (d / R))); // 中心≈0.85 边缘渐隐
          }
        }
      }
      return rgba;
    })();
    var cursorShow = function () {
      rfb._cursor.change(appleCursorRgba, Math.round((APPLE_CURSOR_SIZE - 1) / 2),
                         Math.round((APPLE_CURSOR_SIZE - 1) / 2), APPLE_CURSOR_SIZE, APPLE_CURSOR_SIZE);
    };
    var cursorPoke = function () {
      cursorShow();
      clearTimeout(cursorTimer);
      cursorTimer = setTimeout(cursorHide, CURSOR_IDLE_MS);
    };
    var touchOpt = { capture: true, passive: true };
    screen.addEventListener('touchstart', cursorPoke, touchOpt);
    screen.addEventListener('touchmove', cursorPoke, touchOpt);
    screen.addEventListener('mousemove', cursorPoke, touchOpt);
    screen.addEventListener('mousedown', cursorPoke, touchOpt);
    rfb.addEventListener('disconnect', function () { clearTimeout(cursorTimer); });
  } else {
    rfb.showDotCursor = true;
  }

  // ===== 按键常量 + 统一渲染（07 §4.4：一份数据，PC #bar 与手机 #panel 共用） =====

  /**
   * 按键清单（一份定义，PC #bar 与手机 #panel 共用渲染，消除双份静态 HTML）：
   * op    - data-op 操作标识（与 dispatchOp / caps.js CAP_META 对齐）
   * label - 按钮文案（PC 栏文本 + 面板文字 + 悬浮提示；与网关 KEY_DEFS title 对齐）
   * icon  - 面板图标回退（无 svg 时用 emoji）
   * svg   - 苹果 SF Symbols 风格内联图标（与网关 KEY_DEFS 一致，stroke=currentColor）
   */
  var BAR_KEYS = [
    { op: 'power',    label: '电源',   icon: '⏻',
      svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v8"/><path d="M18.4 6.6a9 9 0 1 1-12.8 0"/></svg>' },
    { op: 'home',     label: 'Home', icon: '🏠',
      svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5L12 3l9 7.5"/><path d="M5 9.5V20h14V9.5"/><path d="M9.5 20v-5.5h5V20"/></svg>' },
    { op: 'volup',    label: '音量 +', icon: '🔊',
      svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9v6h3l5 4V5L7 9H4z"/><path d="M15.5 8.5a4.5 4.5 0 0 1 0 7"/><path d="M19 4v6M16 7h6"/></svg>' },
    { op: 'mute',     label: '静音',   icon: '🔇',
      svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9v6h3l5 4V5L7 9H4z"/><path d="M22 4L4 20"/></svg>' },
    { op: 'voldn',    label: '音量 −', icon: '🔉',
      svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9v6h3l5 4V5L7 9H4z"/><path d="M15.5 8.5a4.5 4.5 0 0 1 0 7"/><path d="M16 7h6"/></svg>' },
    { op: 'briup',    label: '亮度 +', icon: '☀️',
      svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>' },
    { op: 'bridn',    label: '亮度 −', icon: '🌙',
      svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>' },
    { op: 'snapshot', label: '截屏', icon: '✂️',
      svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 5H5V1"/><path d="M23 19H19V23"/><path d="M5 19h14V5H5z" fill="currentColor" fill-opacity=".15" stroke="currentColor"/></svg>' },
    { op: 'spotlight', label: '搜索',  icon: '🔍',
      svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.5-4.5"/></svg>' },
    { op: 'kb',       label: '键盘',   icon: '⌨️',
      svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="6.5" width="19" height="11" rx="2"/><path d="M6 11h1M10 11h1M14 11h1M18 11h1M6 14.5h1M10 14.5h1M14 14.5h1M18 14.5h1"/></svg>' },
    { op: 'clip',     label: '剪贴板', icon: '📋',
      svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2h6v3H9z"/><rect x="4" y="4" width="16" height="18" rx="2"/><path d="M8 11h8M8 15h8M8 19h5"/></svg>' },
    { op: 'full',     label: '全屏',   icon: '⤢',
      svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9V4h5"/><path d="M20 9V4h-5"/><path d="M4 15v5h5"/><path d="M20 15v5h-5"/></svg>' },
    { op: 'disc',     label: '断开',   icon: '✕',
      svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/><path d="M9.5 14.5l5-5"/></svg>' }
  ];

  /**
   * 渲染按键到容器（PC 栏纯文本 / 面板图标+文字，结构与原静态 HTML 兼容，
   * caps.js 增强依赖：bar 用 textContent 覆盖、panel 用 spans[1] 更新）。
   * @param {string} containerId - 容器 id（'bar' 或 'panel'）
   * @returns {void}
   */
  function renderKeys(containerId) {
    var c = document.getElementById(containerId);
    if (!c) return;
    c.innerHTML = '';
    BAR_KEYS.forEach(function (k) {
      var b = document.createElement('button');
      b.setAttribute('data-op', k.op);
      b.title = k.label;
      if (containerId === 'panel') {
        // 面板：图标 span（SF Symbols SVG，无则 emoji）+ 文字 span（与原始 #panel 结构一致）
        var s1 = document.createElement('span');
        s1.innerHTML = k.svg || k.icon;
        b.appendChild(s1);
        var s2 = document.createElement('span');
        s2.textContent = k.label;
        b.appendChild(s2);
        if (k.op === 'disc') { b.style.color = '#ff6b6b'; b.style.borderColor = '#5a2a2a'; }
      } else {
        // PC 栏：图标 + 文字（2026-08-14：与面板一致显示图标，原为纯文本）
        var s1 = document.createElement('span');
        s1.innerHTML = k.svg || k.icon;
        b.appendChild(s1);
        var s2 = document.createElement('span');
        s2.textContent = k.label;
        b.appendChild(s2);
      }
      if (k.op === 'kb') kbdBtns.push(b);   // 键盘键按钮引用（输入源切换高亮用）
      c.appendChild(b);
    });
  }

  renderKeys('bar');
  renderKeys('panel');

  /**
   * 显示中央状态浮层（连接中/已连接等待/已断开/连接失败）
   * @param {string} text  - 状态文案
   * @param {boolean} load - 是否显示加载动画（true=转圈加载）
   * @returns {void}
   */
  function setStatus(text, load) {
    statusText.textContent = text;
    status.classList.toggle('loading', !!load);
    status.classList.add('show');
  }

  /**
   * 隐藏中央状态浮层（收到首帧、进入画面时调用）
   * @returns {void}
   */
  function hideStatus() {
    status.classList.remove('loading', 'show');
  }

  // ===== PC 端：操作栏跟随画面（noVNC 画布）右边框 =====

  /**
   * 同步 PC 端操作栏到画布右边框。
   * 功能：画布由 noVNC 在 #screen 内居中（flex + margin:auto），操作栏以 fixed 脱离
   *       flex 流，运行时按画布实际 rect 定位到其右缘并匹配其高度（贴画面右边框）。
   *       画布尚未出尺寸（0×0，如未连接/未收到首帧）时隐藏操作栏，避免错位闪现。
   * 参数：无
   * @returns {void}
   */
  function syncBarPosition() {
    var b = document.getElementById('bar');
    if (!b) return;
    var cv = screen.querySelector('canvas');
    if (!cv) {
      b.style.display = 'none';
      return;
    }
    var r = cv.getBoundingClientRect();
    if (r.width < 2 || r.height < 2) {
      b.style.display = 'none';
      return;
    }
    b.style.display = '';
    b.style.left = Math.round(r.right) + 'px';
    b.style.top = Math.round(r.top) + 'px';
    b.style.height = Math.round(r.height) + 'px';
  }

  // 画布尺寸变化（首帧到达 / scaleViewport 缩放 / 窗口尺寸变化）时同步操作栏位置
  var barCanvas = screen.querySelector('canvas');
  if (barCanvas && 'ResizeObserver' in window) {
    new ResizeObserver(function () { syncBarPosition(); }).observe(barCanvas);
  }
  window.addEventListener('resize', syncBarPosition);
  syncBarPosition();

  rfb.addEventListener('connect', function () {
    isConnected = true;
    startSigPoll();
    setStatus('已连接，等待画面…', true);
    // 键盘默认收起态（无高亮；用户点「键盘」键才弹出控制端软键盘）
    kbdSoft = false;
    updateKbdBtns();
    // 检测是否真的收到画面帧（区分"连上但黑帧"与"连不上"）
    var gotFrame = false;
    function fbSize() {
      var d = rfb._display;
      if (!d) return 0;
      return d._fbWidth || d._fbHeight || (d.get_width ? d.get_width() : 0) || (d.get_height ? d.get_height() : 0);
    }
    var fc = setInterval(function () {
      if (fbSize() > 0) {
        gotFrame = true;
        clearInterval(fc);
        // 连接成功且收到首帧：隐藏中央状态浮层，进入画面
        hideStatus();
      }
    }, 800);
    setTimeout(function () {
      clearInterval(fc);
      if (!gotFrame) setStatus('已连接但未收到画面（锁屏黑帧 / 抓屏异常 / 编码不支持）', false);
    }, 5000);
  });
  rfb.addEventListener('disconnect', function (e) {
    isConnected = false;
    stopSigPoll();
    setFabSignal(null, '设备未连接（拖动调整位置，点击展开操作）');
    // 断开：键盘收起态复位（无高亮）
    kbdSoft = false; updateKbdBtns();
    var msg = (e && e.detail && e.detail.message) ? '：' + e.detail.message : '';
    setStatus('已断开' + msg + '（目标 ' + url + '）', false);
  });
  rfb.addEventListener('error', function () {
    isConnected = false;
    stopSigPoll();
    setFabSignal(null, '连接失败（拖动调整位置，点击展开操作）');
    kbdSoft = false; updateKbdBtns();
    setStatus('连接失败 ' + url, false);
  });
  rfb.addEventListener('credentialsrequired', function () {
    var p = window.prompt('请输入 VNC 密码：');
    if (p) rfb.sendCredentials({ password: p });
  });

  // ===== 操作执行器（PC 栏与手机面板共用） =====

  /**
   * 发送单次按键（按下 + 短暂抬起）
   * @param {number} ks   - X11 keysym（如 0xff50=Home）
   * @param {string} code - 键码名（如 'Home'）
   * @returns {void}
   */
  function tapKey(ks, code) {
    try { rfb.sendKey(ks, code, true); } catch (e) { return; }
    setTimeout(function () { try { rfb.sendKey(ks, code, false); } catch (e) {} }, 60);
  }

  /**
   * 发送长按按键（按下保持 holdMs 再抬起）——长按 Home 时 down 保持期间
   * iOS 系统识别长按（kbdAddEvent 收到 down 调 menuDown、up 调 menuUp，时序分离）。
   * @param {number} ks     - X11 keysym
   * @param {string} code   - 键码名
   * @param {number} holdMs - 保持时长（毫秒，默认 800）
   * @returns {void}
   */
  function tapKeyHold(ks, code, holdMs) {
    try { rfb.sendKey(ks, code, true); } catch (e) { return; }
    setTimeout(function () { try { rfb.sendKey(ks, code, false); } catch (e) {} }, holdMs || 800);
  }

  /**
   * 直接注入 RFB PointerEvent（type=5）：中键=电源（TrollVNC 映射）
   * @param {number} mask - 按钮掩码（2=中键按下，0=释放）
   * @returns {void}
   */
  function pointer(mask) {
    try {
      var b = new Uint8Array(6);
      b[0] = 5; b[1] = mask; b[2] = 0; b[3] = 1; b[4] = 0; b[5] = 1;
      rfb._sock.send(b.buffer);
      if (mask !== 0) setTimeout(function () { pointer(0); }, 80);
    } catch (e) {}
  }

  /**
   * 长按电源：中键（电源键）按下保持 holdMs 再释放——保持期间 iOS 系统识别长按。
   * @param {number} holdMs - 保持时长（毫秒，默认 800）
   * @returns {void}
   */
  function pointerHold(holdMs) {
    try {
      var b = new Uint8Array(6);
      b[0] = 5; b[1] = 2; b[2] = 0; b[3] = 1; b[4] = 0; b[5] = 1;
      rfb._sock.send(b.buffer);
      setTimeout(function () { pointer(0); }, holdMs || 800);
    } catch (e) {}
  }

  /**
   * 按 data-op 派发对应操作
   * @param {string} op - 操作标识（home/power/volup/.../snapshot/spotlight/kb/clip/full/disc/close）
   * @returns {void}
   */
  function dispatchOp(op) {
    switch (op) {
      // home/power 已走 attachKeyPress 按压识别路径（单击/双击/长按），统一绑定时跳过 click 防双触发；
      // 此分支为兜底（如未来出现未经 attachKeyPress 绑定的 data-op=home 元素）。
      case 'home':  tapKey(0xff50, 'Home'); break;
      // 同上：power 常规短按=中键指针注入（长按走 pointerHold），本分支为兜底路径。
      case 'power': pointer(2); break;
      case 'voldn': tapKey(0x1008ff11, 'AudioVolumeDown'); break;
      case 'volup': tapKey(0x1008ff13, 'AudioVolumeUp'); break;
      case 'mute':  tapKey(0x1008ff12, 'AudioVolumeMute'); break;
      case 'briup': tapKey(0x1008ff03, 'BrightnessUp'); break;
      case 'bridn': tapKey(0x1008ff02, 'BrightnessDown'); break;
      case 'spotlight':
        // 搜索（Spotlight 下拉）：设备端仅 down 时执行 toggleSpotlight，tapKey 发 down+up 一次
        tapKey(0x1008ff1d, 'XF86Search'); break;
      case 'snapshot':
        // 截屏（Home+Power）：设备端仅 down 时执行 snapshotPress，tapKey 发 down+up 一次
        tapKey(0x1008ff80, 'CustomSnapshot'); break;
      case 'kb':
        // 「键盘」输入源切换（2026-08-14 协议 keysym：控制端 ⇄ 被控设备键盘，详见 toggleKbd）
        toggleKbd();
        break;
      case 'clip':
        // 优先用 Clipboard API（安全上下文下生效），失败则降级到手动输入浮层
        tryClipboardPaste();
        break;
      case 'full':
        if (document.fullscreenElement) document.exitFullscreen();
        else document.documentElement.requestFullscreen().catch(function () {});
        break;
      case 'disc':
        try { rfb.disconnect(); } catch (e) {}
        break;
      case 'close': break; // 仅关闭面板，由调用处处理
    }
  }

  // ===== 键盘按钮（2026-08-14 对齐原生 noVNC「Show Keyboard」：显示/隐藏控制端软键盘） =====

  /**
   * 更新键盘键按钮的高亮与提示（PC 栏 + 面板同步）：
   * 控制端软键盘激活（kbdSoft=true）加 .kbd-on 高亮（原生 noVNC selected 风格），收起则无高亮。
   * @returns {void}
   */
  function updateKbdBtns() {
    kbdBtns.forEach(function (b) {
      b.classList.toggle('kbd-on', kbdSoft);
      b.title = kbdSoft ? '收起控制端键盘' : '弹出控制端键盘';
    });
  }

  /**
   * 聚焦隐藏 input 唤起控制端软键盘（iOS 对文本输入元素 focus 才弹键盘）
   * @returns {void}
   */
  function focusKbInput() {
    var kbi = document.getElementById('kbInput');
    if (!kbi) return;
    try {
      kbi.focus();
      if (kbi.setSelectionRange) { try { kbi.setSelectionRange(kbi.value.length, kbi.value.length); } catch (e) {} }
    } catch (e) {}
  }

  /**
   * 收起控制端软键盘（blur 触发系统收起）。
   * iOS Safari 对隐藏 input 直接 blur() 常不收起系统软键盘（焦点行为差异、收起异步），
   * 是"控制端软键盘残留 + 被控键盘弹出 = 两个键盘同时显示"的根因之一。
   * 组合手段确保收起：activeElement.blur + readonly 切换（iOS 经典 trick，延时恢复 readonly）。
   * @returns {void}
   */
  function blurKbInput() {
    var kbi = document.getElementById('kbInput');
    if (!kbi) return;
    try { if (document.activeElement && document.activeElement.blur) document.activeElement.blur(); } catch (e) {}
    try {
      kbi.setAttribute('readonly', 'readonly');
      kbi.blur();
    } catch (e) {}
    setTimeout(function () { try { kbi.removeAttribute('readonly'); } catch (e) {} }, 120);
  }

  /**
   * 键盘键点击 = 显示/隐藏控制端软键盘（对齐上游原生 noVNC「Show Keyboard」）。
   * 聚焦 kbInput 弹控制端软键盘（iOS 对文本输入元素 focus 才弹键盘），再次点击失焦收起。
   * 按键经 Keyboard 实例转发 rfb.sendKey 直达设备；被控端键盘由被控端系统自行管理。
   * @returns {void}
   */
  function toggleKbd() {
    if (kbdSoft) {
      blurKbInput();
    } else {
      focusKbInput();
    }
  }

  // ===== 软键盘输入：kb 键聚焦 #kbInput 唤起 iOS 软键盘，Keyboard 实例直接抓取 keydown/keyup 直发 =====
  // noVNC 官方 touch 键盘方案（ui.js touchKeyboard）：Keyboard 绑定隐藏 input，onkeyevent 转发 rfb.sendKey。
  // 相比 input 事件逐字符 diff，可捕获回车/组合键等不产生文本增量的按键；与网关控制台触屏端行为一致。

  var kbInput = document.getElementById('kbInput');
  if (kbInput) {
    var touchKb = new Keyboard(kbInput);
    touchKb.onkeyevent = function (keysym, code, down) {
      try { rfb.sendKey(keysym, code, down); } catch (e) {}
    };
    touchKb.grab();
    // 控制端软键盘被系统收起（点击别处/滚动/切后台）：复位 kbdSoft 与按钮高亮
    kbInput.addEventListener('blur', function () {
      kbdSoft = false;
      updateKbdBtns();
    });
    // 断开/失败：释放按键（Keyboard 内部 window blur 已兜底，这里显式清理避免残留）
    rfb.addEventListener('disconnect', function () { try { touchKb.ungrab(); } catch (e) {} });
    rfb.addEventListener('error', function () { try { touchKb.ungrab(); } catch (e) {} });
  }

  // ===== 剪贴板降级方案：Clipboard API 失败时弹出手动输入浮层 =====

  /**
   * 尝试读取本机剪贴板并粘贴到远端；失败或为空时降级到手动输入浮层
   * @returns {void}
   */
  function tryClipboardPaste() {
    if (navigator.clipboard && navigator.clipboard.readText) {
      navigator.clipboard.readText().then(function (t) {
        if (t) {
          try { rfb.clipboardPasteFrom(t); } catch (e) {}
        } else {
          // 剪贴板为空，降级到手动输入
          showClipModal();
        }
      }).catch(function () {
        // Clipboard API 被拒绝（HTTP 环境常见），降级到手动输入
        showClipModal();
      });
    } else {
      // 浏览器不支持 Clipboard API，直接降级
      showClipModal();
    }
  }

  var clipOverlay = document.getElementById('clipOverlay');
  var clipText = document.getElementById('clipText');
  var clipSend = document.getElementById('clipSend');
  var clipCancel = document.getElementById('clipCancel');

  /**
   * 显示剪贴板手动输入浮层，用户粘贴文本后点击发送
   * @returns {void}
   */
  function showClipModal() {
    clipText.value = '';
    clipOverlay.classList.add('show');
    // 延迟聚焦以等待过渡动画完成（部分浏览器需要元素可见后才能聚焦）
    setTimeout(function () {
      clipText.focus();
    }, 100);
  }

  /**
   * 关闭剪贴板浮层并清除内容
   * @returns {void}
   */
  function closeClipModal() {
    clipOverlay.classList.remove('show');
    clipText.value = '';
  }

  // 发送按钮：将 textarea 内容粘贴到远端并关闭浮层
  clipSend.addEventListener('click', function () {
    var t = clipText.value;
    if (t) {
      try { rfb.clipboardPasteFrom(t); } catch (e) {}
    }
    closeClipModal();
  });

  // 取消按钮：关闭浮层
  clipCancel.addEventListener('click', closeClipModal);

  // 点击遮罩区域关闭浮层
  clipOverlay.addEventListener('click', function (e) {
    if (e.target === clipOverlay) closeClipModal();
  });

  /**
   * 为按钮附加按压识别（home/power 专用）：
   * 短按（<800ms）：抬起即触发 tap——快速两次点击即两次 tap 时序（iOS 识别双击 Home/电源）；
   *                tap 后延迟 300ms 收起所在面板（保留双击窗口，第二次点击仍能命中按钮）；
   * 长按（≥800ms）：down 保持期间触发 hold（tapKeyHold/pointerHold 保持 800ms 再抬起，iOS 识别长按）。
   * pointerdown 时设置指针捕获（setPointerCapture，浏览器不支持时忽略）：按住拖出按钮后
   * pointerup 仍派发到本按钮，800ms 定时器正常清理，避免移出松开误发长按。
   * @param {HTMLElement} btn - 目标按钮
   * @param {Function} tap    - 短按动作（单击/双击均经此，双击=两次 keysym/指针时序）
   * @param {Function} hold   - 长按动作（按下保持后再抬起）
   * @returns {void}
   */
  function attachKeyPress(btn, tap, hold) {
    var pressTimer = null;
    var holdFired = false;

    btn.addEventListener('pointerdown', function (e) {
      try { e.preventDefault(); } catch (err) {}   // 阻止 iOS 长按系统菜单/文本选择
      // 指针捕获：按住后拖出按钮，pointerup 仍派发到本按钮，保证 800ms 定时器被清理，避免误发长按
      if (btn.setPointerCapture) { try { btn.setPointerCapture(e.pointerId); } catch (err) {} }
      holdFired = false;
      pressTimer = setTimeout(function () { holdFired = true; hold(); }, 800);
    });
    btn.addEventListener('pointerup', function () {
      if (pressTimer) { clearTimeout(pressTimer); pressTimer = null; }
      if (holdFired) return;   // 长按已触发，抬起不再补发单击
      tap();
    });
    btn.addEventListener('pointercancel', function () {
      if (pressTimer) { clearTimeout(pressTimer); pressTimer = null; }
    });
    // 键盘兜底：Tab+Enter/Space 触发 tap（home/power 改 pointer 事件后原生 click 不触发）
    btn.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        tap();
      }
    });
  }

  /**
   * 按住连发按键（音量/亮度/静音）的 down/up 分离式按压（2026-08-14 方案 A 升级）：
   * 按下即发送 keysym down、抬起发送 up、按住期间保持 down——iOS 对按住不松的音量/亮度键
   * 自动连发（物理按键行为），替代原 tap 式（down+60ms+up 一次性），对齐网关控制台按压语义。
   * 触控类按键无双击/长按语义；面板不因点击按钮收起（与网关控制台一致）。
   * @param {HTMLElement} btn  - 目标按钮
   * @param {number} ks       - X11 keysym（如 0x1008ff13=音量+）
   * @param {string} code     - 键码名（如 'AudioVolumeUp'）
   * @returns {void}
   */
  function attachKeyPressDownUp(btn, ks, code) {
    btn.addEventListener('pointerdown', function (e) {
      try { e.preventDefault(); } catch (err) {}   // 阻止 iOS 长按系统菜单/文本选择
      try { rfb.sendKey(ks, code, true); } catch (e) {}
    });
    btn.addEventListener('pointerup', function () {
      try { rfb.sendKey(ks, code, false); } catch (e) {}
    });
    btn.addEventListener('pointercancel', function () {
      try { rfb.sendKey(ks, code, false); } catch (e) {}
    });
  }

  /**
   * 按住连发按键映射：op → [keysym, 键码名]
   * 与网关 KEY_DEFS 的 down/up 事件集（volup.down/volup.up 等）对齐
   */
  var DOWNUP_KEYS = {
    volup: [0x1008ff13, 'AudioVolumeUp'],
    voldn: [0x1008ff11, 'AudioVolumeDown'],
    mute:  [0x1008ff12, 'AudioVolumeMute'],
    briup: [0x1008ff03, 'BrightnessUp'],
    bridn: [0x1008ff02, 'BrightnessDown']
  };

  // 统一绑定 data-op 按钮（PC 栏 + 手机面板）。
  // home/power 走 attachKeyPress 按压识别（单击/双击/长按），跳过 click 统一绑定避免双触发；
  // 音量/亮度/静音走 attachKeyPressDownUp 按住连发（down/up 分离式），同样跳过 click 防双触发；
  // 其余按钮保持 click → dispatchOp。面板不因点击按钮自动收起（与网关控制台一致），仅 FAB/点外部收起。
  document.querySelectorAll('[data-op]').forEach(function (btn) {
    var op = btn.getAttribute('data-op');
    if (op === 'home') {
      attachKeyPress(btn,
        function () { tapKey(0xff50, 'Home'); },
        function () { tapKeyHold(0xff50, 'Home', 800); });
      return;
    }
    if (op === 'power') {
      attachKeyPress(btn,
        function () { pointer(2); },
        function () { pointerHold(800); });
      return;
    }
    var dk = DOWNUP_KEYS[op];
    if (dk) {
      attachKeyPressDownUp(btn, dk[0], dk[1]);
      return;
    }
    btn.addEventListener('click', function () {
      dispatchOp(op);
    });
  });

  // ===== 悬浮按钮信号状态 + 拖动 + 点击展开 =====

  /**
   * 更新 FAB 信号格亮起状态（直连页无网关 ping 通道，以连接状态驱动）
   * @param {string|null} sig - 'sig-high'/'sig-mid'/'sig-low'，null 表示全灰
   * @param {string} tip      - 按钮悬浮提示文案
   * @returns {void}
   */
  function setFabSignal(sig, tip) {
    var f = document.getElementById('fab');
    if (!f) return;
    if (sig) f.setAttribute('data-sig', sig); else f.removeAttribute('data-sig');
    if (tip) f.title = tip;
  }

  /**
   * 启动延迟轮询：每 3s 同源 fetch 一个静态文件（caps.js，no-store）测网络往返耗时，
   * 按与网关控制台一致的阈值驱动信号格（<150ms 满格绿 / <400ms 中黄 / 否则红点）。
   * 仅在已连接（isConnected）时更新颜色；未连接保持全灰。
   * @returns {void}
   */
  function startSigPoll() {
    stopSigPoll();
    var tick = function () {
      var t0 = performance.now();
      fetch('./caps.js?t=' + Date.now(), { cache: 'no-store' }).then(function () {
        if (!isConnected) return;   // 未连接：忽略延迟结果，保持灰
        var ms = Math.round(performance.now() - t0);
        setFabSignal(ms < 150 ? 'sig-high' : (ms < 400 ? 'sig-mid' : 'sig-low'),
                     '已连接 · 延迟 ' + ms + 'ms（拖动调整位置，点击展开操作）');
      }).catch(function () {
        if (!isConnected) return;
        setFabSignal('sig-low', '设备无响应（拖动调整位置，点击展开操作）');
      });
    };
    tick();
    sigTimer = setInterval(tick, 3000);
  }

  /**
   * 停止延迟轮询（断开/连接失败时调用，释放定时器）。
   * @returns {void}
   */
  function stopSigPoll() {
    if (sigTimer) { clearInterval(sigTimer); sigTimer = null; }
  }

  var fab = document.getElementById('fab');
  var panel = document.getElementById('panel');
  var dragState = null;   // { startX, startY, originLeft, originTop, moved }

  /**
   * 计算 FAB 拖动安全边界（考虑 env(safe-area-inset-*) 避开刘海/Home 条）
   * @returns {{minX:number, minY:number, maxX:number, maxY:number}} FAB 左上角可移动范围（px）
   */
  function getSafeBounds() {
    var cs = getComputedStyle(document.documentElement);
    // 读取 env() 计算后的像素值；非 iOS 设备返回 0
    var st = parseInt(cs.getPropertyValue('--safe-top')) || 0;
    var sr = parseInt(cs.getPropertyValue('--safe-right')) || 0;
    var sb = parseInt(cs.getPropertyValue('--safe-bottom')) || 0;
    var sl = parseInt(cs.getPropertyValue('--safe-left')) || 0;
    var pad = 8;  // 额外留白，避免 FAB 紧贴边缘
    var vw = window.innerWidth, vh = window.innerHeight;
    var fw = fab.offsetWidth, fh = fab.offsetHeight;
    return {
      minX: sl + pad,
      minY: st + pad,
      maxX: vw - fw - sr - pad,
      maxY: vh - fh - sb - pad
    };
  }

  /**
   * 计算面板弹出位置（2026-08-14：改为水平展开）：
   * 按 FAB 所在半屏决定方向——左半屏向右展开、右半屏向左展开（该侧空间不足自动换侧）；
   * 水平方向完全避开 FAB 区域，垂直与 FAB 顶部对齐并按视口裁剪 max-height，保证不覆盖悬浮按钮。
   * @returns {{left:number, top:number}} 面板左上角坐标（px）
   */
  function computePanelPos() {
    var fr = fab.getBoundingClientRect();
    var vw = window.innerWidth, vh = window.innerHeight;
    var gap = 10, pad = 8;
    // 重置 maxHeight 后测量面板原始尺寸（CSS 默认 70vh 上限）
    panel.style.maxHeight = '';
    var pw = panel.offsetWidth || 168;
    var ph = panel.offsetHeight || 360;
    var maxH = Math.max(80, Math.min(ph, vh - pad * 2));
    panel.style.maxHeight = maxH + 'px';
    var mh = Math.min(ph, maxH);
    // 水平：FAB 在左半屏 → 右侧展开；右半屏 → 左侧展开；空间不足自动换侧，钳制在视口内
    var fabCenter = fr.left + fr.width / 2;
    var spaceRight = vw - (fr.right + gap) - pad;
    var spaceLeft = fr.left - gap - pad;
    var left;
    if (fabCenter < vw / 2) left = spaceRight >= pw ? fr.right + gap : fr.left - gap - pw;
    else left = spaceLeft >= pw ? fr.left - gap - pw : fr.right + gap;
    if (left < pad) left = pad;
    if (left + pw > vw - pad) left = vw - pw - pad;
    // 垂直：与 FAB 顶部对齐，约束在视口内（水平已避开 FAB，垂直重叠不遮按钮）
    var top = fr.top;
    if (top + mh > vh - pad) top = vh - mh - pad;
    if (top < pad) top = pad;
    return { left: left, top: top };
  }

  /**
   * 切换操作面板显隐（显示时按 FAB 位置定位）
   * @returns {void}
   */
  function togglePanel() {
    if (panel.classList.contains('show')) {
      panel.classList.remove('show');
      return;
    }
    panel.classList.add('show');      // 先显示以获取尺寸
    var pos = computePanelPos();
    panel.style.left = pos.left + 'px';
    panel.style.top = pos.top + 'px';
  }

  /**
   * 拖动开始：记录起点与 FAB 原始位置
   * @param {PointerEvent} e - 指针事件
   * @returns {void}
   */
  fab.addEventListener('pointerdown', function (e) {
    var rect = fab.getBoundingClientRect();
    dragState = {
      startX: e.clientX, startY: e.clientY,
      originLeft: rect.left, originTop: rect.top,
      moved: false
    };
    fab.classList.add('dragging');
    try { fab.setPointerCapture(e.pointerId); } catch (err) {}
    e.preventDefault();
  });

  /**
   * 拖动中：更新 FAB 位置并约束在视口内
   * @param {PointerEvent} e - 指针事件
   * @returns {void}
   */
  fab.addEventListener('pointermove', function (e) {
    if (!dragState) return;
    var dx = e.clientX - dragState.startX;
    var dy = e.clientY - dragState.startY;
    if (Math.abs(dx) > 6 || Math.abs(dy) > 6) dragState.moved = true;
    var nx = dragState.originLeft + dx;
    var ny = dragState.originTop + dy;
    // 边界约束（考虑 env(safe-area-inset-*) 避开刘海/Home 条）
    var b = getSafeBounds();
    nx = Math.max(b.minX, Math.min(nx, b.maxX));
    ny = Math.max(b.minY, Math.min(ny, b.maxY));
    fab.style.left = nx + 'px';
    fab.style.top = ny + 'px';
    fab.style.right = 'auto';
    fab.style.bottom = 'auto';
    // 面板可见时实时跟随 FAB 重新定位（仅真正拖动后触发，避免轻微抖动闪烁）
    if (panel.classList.contains('show') && dragState.moved) {
      var pos = computePanelPos();
      panel.style.left = pos.left + 'px';
      panel.style.top = pos.top + 'px';
    }
  });

  /**
   * 拖动结束：未移动则视为点击（展开/收起面板）
   * @param {PointerEvent} e - 指针事件
   * @returns {void}
   */
  fab.addEventListener('pointerup', function (e) {
    var wasMoved = dragState && dragState.moved;
    fab.classList.remove('dragging');
    try { fab.releasePointerCapture(e.pointerId); } catch (err) {}
    dragState = null;
    if (!wasMoved) togglePanel();
  });

  fab.addEventListener('pointercancel', function () {
    fab.classList.remove('dragging');
    dragState = null;
  });

  // 点击面板外区域收起面板
  document.addEventListener('pointerdown', function (e) {
    if (!panel.classList.contains('show')) return;
    if (panel.contains(e.target) || e.target === fab) return;
    panel.classList.remove('show');
  });

  // 窗口尺寸变化时：约束 FAB 位置到新视口内 + 若面板可见则重新定位
  window.addEventListener('resize', function () {
    // 1. 约束 FAB 位置到新视口内（避免旋转/缩放后越界消失）
    var fabRect = fab.getBoundingClientRect();
    var b = getSafeBounds();
    var nx = Math.max(b.minX, Math.min(fabRect.left, b.maxX));
    var ny = Math.max(b.minY, Math.min(fabRect.top, b.maxY));
    if (Math.abs(nx - fabRect.left) > 0.5 || Math.abs(ny - fabRect.top) > 0.5) {
      fab.style.left = nx + 'px';
      fab.style.top = ny + 'px';
      fab.style.right = 'auto';
      fab.style.bottom = 'auto';
    }
    // 2. 面板可见时重新定位跟随 FAB
    if (panel.classList.contains('show')) {
      var pos = computePanelPos();
      panel.style.left = pos.left + 'px';
      panel.style.top = pos.top + 'px';
    }
  });

  // 能力清单增强（可选）：caps.js 可加载时覆盖按钮标题（失败不影响连接）
  import('./caps.js').then(function (m) {
    if (!m || !m.CAP_META) return;
    // 同时更新 PC 栏与手机面板按钮文案（含 keyboard/clipboard）
    document.querySelectorAll('[data-op]').forEach(function (btn) {
      var op = btn.getAttribute('data-op');
      var meta = m.CAP_META[op];
      if (!meta) return;
      // 面板按钮：保留图标 + 更新文字 span
      if (btn.closest('#panel')) {
        var spans = btn.querySelectorAll('span');
        if (spans.length >= 2) spans[1].textContent = meta.label;
      }
      // PC 栏按钮：保留图标 + 更新文字 span（2026-08-14：bar 已显示图标，原为纯文本覆盖）
      if (btn.closest('#bar')) {
        var spans = btn.querySelectorAll('span');
        if (spans.length >= 2) spans[1].textContent = meta.label;
      }
    });
  }).catch(function () {});
})();
</script>
</body>
</html>
